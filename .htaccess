Options -Indexes
DirectoryIndex login.php index.php

RewriteEngine On
RewriteBase /erp/

# ZKTeco ADMS endpoints
RewriteRule ^iclock/cdata$         iclock/cdata.php [L,QSA]
RewriteRule ^iclock/getrequest$    iclock/getrequest.php [L,QSA]
RewriteRule ^iclock/devicecmd$     iclock/devicecmd.php [L,QSA]

# Cho phép truy cập trực tiếp vào file tĩnh trong uploads (ảnh chấm công)
RewriteRule ^uploads/ - [L]

# Redirect / về login
RewriteRule ^$ login.php [R=302,L]

php_flag display_errors On
php_flag display_startup_errors On
php_value error_reporting 32767